<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#34D8FF"/><corners android:radius="13dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#1688FF"/><corners android:radius="13dp"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
    </item>
    <item>
        <shape><solid android:color="#1688FF"/><corners android:radius="13dp"/><stroke android:width="1dp" android:color="#5BC8FF"/></shape>
    </item>
</selector>
