<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0D438B"
                android:endColor="#0B2F68" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#34D8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0B3978"
                android:endColor="#092653" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#4388C9" />
        </shape>
    </item>
</selector>
