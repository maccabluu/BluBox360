<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><gradient android:angle="270" android:startColor="#148CFF" android:endColor="#07366E"/><corners android:radius="16dp"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><gradient android:angle="270" android:startColor="#148CFF" android:endColor="#07366E"/><corners android:radius="16dp"/><stroke android:width="3dp" android:color="#34D8FF"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><gradient android:angle="270" android:startColor="#1688FF" android:endColor="#082F62"/><corners android:radius="16dp"/><stroke android:width="3dp" android:color="#34D8FF"/></shape>
    </item>
    <item>
        <shape><gradient android:angle="270" android:startColor="#174A82" android:endColor="#0A1930"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#3C628A"/></shape>
    </item>
</selector>
