<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#1C5898"/><corners android:radius="13dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#173D67"/><corners android:radius="13dp"/><stroke android:width="3dp" android:color="#34D8FF"/></shape>
    </item>
    <item>
        <shape><solid android:color="#122746"/><corners android:radius="13dp"/><stroke android:width="1dp" android:color="#315478"/></shape>
    </item>
</selector>
